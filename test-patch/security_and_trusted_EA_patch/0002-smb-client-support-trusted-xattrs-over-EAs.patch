From f8310d206b4d200a9820a09b1c1320628eca4e0c Mon Sep 17 00:00:00 2001
From: Ze Tan <tanze@kylinos.cn>
Date: Thu, 9 Jul 2026 16:48:06 +0800
Subject: [PATCH 2/5] smb: client: support trusted xattrs over EAs

The client currently exposes server EAs through the user.* namespace and
has no xattr handler for trusted.*. As a result, applications cannot set,
query or list Linux trusted xattrs through CIFS even when the server uses
the same EA name.

Add a trusted xattr handler and build the full server EA name by adding
the "trusted." prefix before issuing SMB2 EA set/query operations. Keep
trusted.* names unchanged when listing EAs so that attributes such as
trusted.name are reported through the Linux trusted namespace instead of
being converted to user.trusted.name.

This allows trusted xattrs to be preserved and observed correctly by
tests that verify capability clearing does not remove unrelated xattrs.

Signed-off-by: Ze Tan <tanze@kylinos.cn>
---
 fs/smb/client/smb2ops.c |  9 ++++++---
 fs/smb/client/xattr.c   | 32 +++++++++++++++++++++-----------
 2 files changed, 27 insertions(+), 14 deletions(-)

diff --git a/fs/smb/client/smb2ops.c b/fs/smb/client/smb2ops.c
index 3da612f27c70..d8c5e8ecddb5 100644
--- a/fs/smb/client/smb2ops.c
+++ b/fs/smb/client/smb2ops.c
@@ -1088,9 +1088,12 @@ move_smb2_ea_to_cifs(char *dst, size_t dst_size,
 			bool prefixed_name;
 
 			prefixed_name =
-				posix_extensions &&
-				name_len == sizeof(XATTR_NAME_CAPS) - 1 &&
-				!memcmp(name, XATTR_NAME_CAPS, name_len);
+				(name_len > XATTR_TRUSTED_PREFIX_LEN &&
+				 !memcmp(name, XATTR_TRUSTED_PREFIX,
+					 XATTR_TRUSTED_PREFIX_LEN)) ||
+				(posix_extensions &&
+				 name_len == sizeof(XATTR_NAME_CAPS) - 1 &&
+				 !memcmp(name, XATTR_NAME_CAPS, name_len));
 			if (prefixed_name)
 				user_name_len = name_len + 1;
 			else
diff --git a/fs/smb/client/xattr.c b/fs/smb/client/xattr.c
index 19052f0b3470..0f49d0934e1b 100644
--- a/fs/smb/client/xattr.c
+++ b/fs/smb/client/xattr.c
@@ -36,7 +36,7 @@
 #define SMB3_XATTR_CIFS_NTSD_FULL "system.smb3_ntsd_full" /* owner/DACL/SACL */
 #define SMB3_XATTR_ATTRIB "smb3.dosattrib"  /* full name: user.smb3.dosattrib */
 #define SMB3_XATTR_CREATETIME "smb3.creationtime"  /* user.smb3.creationtime */
-enum { XATTR_USER, XATTR_SECURITY,
+enum { XATTR_USER, XATTR_TRUSTED, XATTR_SECURITY,
 	XATTR_CIFS_ACL, XATTR_ACL_ACCESS, XATTR_ACL_DEFAULT,
 	XATTR_CIFS_NTSD_SACL, XATTR_CIFS_NTSD_OWNER,
 	XATTR_CIFS_NTSD, XATTR_CIFS_NTSD_FULL };
@@ -58,6 +58,16 @@ static int cifs_build_ea_name(int xattr_flag, const char *name, char *ea_name,
 		memcpy(ea_name + XATTR_SECURITY_PREFIX_LEN, name,
 		       name_len + 1);
 		return XATTR_SECURITY_PREFIX_LEN + name_len;
+	case XATTR_TRUSTED:
+		name_len = strlen(name);
+		if (ea_name_size <= XATTR_TRUSTED_PREFIX_LEN ||
+		    name_len > ea_name_size - XATTR_TRUSTED_PREFIX_LEN - 1)
+			return -ERANGE;
+		memcpy(ea_name, XATTR_TRUSTED_PREFIX,
+		       XATTR_TRUSTED_PREFIX_LEN);
+		memcpy(ea_name + XATTR_TRUSTED_PREFIX_LEN, name,
+		       name_len + 1);
+		return XATTR_TRUSTED_PREFIX_LEN + name_len;
 	case XATTR_USER:
 	default:
 		len = strscpy(ea_name, name, ea_name_size);
@@ -161,12 +171,8 @@ static int cifs_xattr_set(const struct xattr_handler *handler,
 
 	switch (handler->flags) {
 	case XATTR_USER:
+	case XATTR_TRUSTED:
 	case XATTR_SECURITY:
-		if (handler->flags == XATTR_SECURITY &&
-		    !pTcon->posix_extensions) {
-			rc = -EOPNOTSUPP;
-			goto out;
-		}
 		rc = cifs_build_ea_name(handler->flags, name, ea_name,
 					sizeof(ea_name));
 		if (rc < 0)
@@ -343,12 +349,8 @@ static int cifs_xattr_get(const struct xattr_handler *handler,
 	/* return alt name if available as pseudo attr */
 	switch (handler->flags) {
 	case XATTR_USER:
+	case XATTR_TRUSTED:
 	case XATTR_SECURITY:
-		if (handler->flags == XATTR_SECURITY &&
-		    !pTcon->posix_extensions) {
-			rc = -EOPNOTSUPP;
-			goto out;
-		}
 		rc = cifs_build_ea_name(handler->flags, name, ea_name,
 					sizeof(ea_name));
 		if (rc < 0)
@@ -497,6 +499,13 @@ static const struct xattr_handler cifs_user_xattr_handler = {
 	.set = cifs_xattr_set,
 };
 
+static const struct xattr_handler cifs_trusted_xattr_handler = {
+	.prefix = XATTR_TRUSTED_PREFIX,
+	.flags = XATTR_TRUSTED,
+	.get = cifs_xattr_get,
+	.set = cifs_xattr_set,
+};
+
 static const struct xattr_handler cifs_security_xattr_handler = {
 	.prefix = XATTR_SECURITY_PREFIX,
 	.flags = XATTR_SECURITY,
@@ -588,6 +597,7 @@ static const struct xattr_handler smb3_ntsd_full_xattr_handler = {
 
 const struct xattr_handler * const cifs_xattr_handlers[] = {
 	&cifs_user_xattr_handler,
+	&cifs_trusted_xattr_handler,
 	&cifs_security_xattr_handler,
 	&cifs_os2_xattr_handler,
 	&cifs_cifs_acl_xattr_handler,
-- 
